{
  "name": "pomocnik-zadan",
  "private": true,
  "version": "1.0.0",
  "description": "Wtyczka do Chrome, która odczytuje zadanie ze strony i przygotowuje rozwiązanie (Claude API).",
  "scripts": {
    "build": "esbuild src/panel.js --bundle --format=esm --target=chrome114 --minify --outfile=extension/panel.js",
    "zip": "cd extension && zip -r ../pomocnik-zadan.zip . -x '.*'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@google/genai": "2.29.1",
    "dompurify": "3.4.16",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
