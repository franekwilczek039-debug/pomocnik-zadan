{
  "manifest_version": 3,
  "name": "Pomocnik Zadań AI",
  "version": "1.0.0",
  "description": "Odczytuje zadanie z otwartej strony i przygotowuje rozwiązanie do wklejenia (Claude AI, własny klucz API).",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Pomocnik Zadań AI", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "116"
}
